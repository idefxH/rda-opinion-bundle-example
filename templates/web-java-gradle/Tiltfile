v1alpha1.extension_repo(
    name='suse-rda',
    url='https://github.com/idefxH/tilt-extension-suse-rda',
    ref='{{ .ExtensionRef }}',
)
v1alpha1.extension(
    name='suse-rda',
    repo_name='suse-rda',
    repo_path='suse_rda',
)
load('ext://suse-rda', 'suse_app')

# ── Discover workloads from deploy/values.yaml ──────────────────────
_vals = read_yaml('deploy/values.yaml')
_lib = _vals.get('suse-library', {})
_workloads = _lib.get('workloads', [])
_release = _lib.get('name', '')

# ── Helm chart deployment ───────────────────────────────────────────
suse_app(
    name=_release,
    language='{{ .Language }}',
    chart_path='deploy',
)

# ── Per-workload: image build + port-forward ────────────────────────
for _wl in _workloads:
    _wl_name = _wl['name']
    _resource = '%s-%s' % (_release, _wl_name)
    _img = _wl.get('image', {})
    _repo = _img.get('repository', '')
    _tag = _img.get('tag', '')
    _port = _wl.get('port', None)

    # Build locally-developed images (convention: tag == 'dev').
    # Pre-built / external images (any other tag) are used as-is.
    if _repo and _tag == 'dev':
        custom_build(
            _repo,
            'pack build $EXPECTED_REF --path . --builder paketobuildpacks/builder-jammy-base --trust-builder',
            ['.'],
            skips_local_docker=False,
        )

    # Port-forward for workloads that expose a port.
    if _port:
        k8s_resource(
            _resource,
            port_forwards=['%d:%d' % (int(_port), int(_port)),],
        )
