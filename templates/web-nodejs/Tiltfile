    name='suse-rda',
    url='https://github.com/idefxH/tilt-extension-suse-rda',
)
v1alpha1.extension(
    name='suse-rda',
    repo_name='suse-rda',
    repo_path='suse_rda',
)
load('ext://suse-rda', 'suse_app')

suse_app(
    name='{{ .Name }}',
    language='{{ .Language }}',
    port=8080,
    services={'database': 'postgresql'},
)
