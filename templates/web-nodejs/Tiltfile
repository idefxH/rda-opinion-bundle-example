# Tiltfile for {{ .Name }} — generated by rda from web-nodejs template.
#
# Loads the SUSE Tilt extension (idefxH/tilt-extension-suse-rda) via Tilt's
# v1alpha1.Extension API. Tilt clones and caches the repo automatically;
# restart `tilt up` to pick up extension updates.

v1alpha1.extension_repo(
    name='suse-rda',
    url='https://github.com/idefxH/tilt-extension-suse-rda',
    # Pinned by semver tag (tilt-ext #14) — without `ref=`, Tilt
    # checks out the repo's default branch (main), so a `tilt up`
    # on Tuesday silently picks up changes pushed Monday afternoon.
    # Bumping this line is an explicit, reviewable upgrade. Override
    # locally for testing by editing this file.
    ref='{{ .ExtensionRef }}',
)
v1alpha1.extension(
    name='suse-rda',
    repo_name='suse-rda',
    repo_path='suse_rda',
)
load('ext://suse-rda', 'suse_app')

# Service port-forwards are auto-discovered from `deploy/values.yaml`:
# every entry under `services[]` with provisioning: local + enabled: true
# gets a port-forward registered.
#
# `rda add-service <type> <binding>` updates values.yaml; nothing in this
# Tiltfile needs to change. To remove a port-forward, drop the entry from
# values.yaml's services[] list.
suse_app(
    name='{{ .Name }}',
    language='{{ .Language }}',
    chart_path='deploy',
)
# port is derived from `suse-library.port` in deploy/values.yaml — the
# library chart's deployment renders containerPort and Service targetPort
# from there, so values.yaml stays the single source of truth. Override
# only by editing values.yaml; pass `port=NNN` here only if you need to
# force a mismatch (the Tiltfile fails fast otherwise).
