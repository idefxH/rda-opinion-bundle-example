#
# v0: uses docker_build directly. When the SUSE Tilt extension ships, this
# Tiltfile will switch to:
#   load('ext://suse_rda', 'suse_app')
#   suse_app(name='{{ .Name }}', language='{{ .Language }}', port=8080,
#            services=['database'])

load('ext://restart_process', 'docker_build_with_restart')

# Build the application image using the BCI-based Dockerfile.
docker_build_with_restart(
    '{{ .Name }}:dev',
    '.',
    dockerfile='Dockerfile',
    entrypoint='node /app/src/index.js',
    live_update=[
        sync('./src', '/app/src'),
        run('cd /app && npm install', trigger=['./package.json', './package-lock.json']),
    ],
    only=['./src', './package.json', './package-lock.json'],
)

# Install the Helm chart.
k8s_yaml(helm(
    '.',
    name='{{ .Name }}',
    values=['./values.yaml'],
))

# Surface the application Service on localhost:8080.
k8s_resource(
    workload='{{ .Name }}',
    port_forwards='8080:8080',
    labels=['app'],
)

# Surface the local Postgres on localhost:5432 for inspection with psql or DBeaver.
k8s_resource(
    workload='{{ .Name }}-database',
    port_forwards='5432:5432',
    labels=['services'],
)
