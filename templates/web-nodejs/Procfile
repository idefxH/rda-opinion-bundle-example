# CNB Procfile — declares the launch processes buildpacks register.
#
# - web: production launch via plain `node`.
# - dev:  development launch via `nodemon -L` (polling mode). Robust
#   against containerd/overlayfs inotify quirks that break node --watch
#   in k8s setups. nodemon polls every 1s — slower than inotify but
#   reliable for live_update file syncs.
web: node src/index.js
dev: npx nodemon -L src/index.js
