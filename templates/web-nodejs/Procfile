# CNB Procfile — declares the launch processes that buildpacks register.
#
# - web: production launch. Plain node, no watcher overhead.
# - dev: development launch. nodemon with -L (legacy polling) so the
#   watcher works through containerd/overlayfs filesystems where
#   inotify events from `tar | kubectl exec` syncs aren't reliably
#   propagated. nodemon is in `dependencies` (not devDeps) so it
#   ships in every build — small extra MB, but no env juggling
#   needed at pack time.
web: node src/index.js
dev: ./node_modules/.bin/nodemon -L src/index.js
